# ------------------------------------------------------------------------------
# Scatch frontend - environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------------------

# Base URL of the Scatch API.
#
# Development: leave EMPTY and the Vite dev server proxies `/api` to
# http://localhost:3000 (see vite.config.js), so one origin handles everything
# and cookies just work.
#
# Production (Vercel): set this to your Render API URL, e.g.
#   https://scatch-api.onrender.com
#
# Note: this value is baked into the bundle at BUILD time on Vercel. If you
# change it you must redeploy, not just restart.
VITE_API_URL=

# Cloudinary cloud name, used to build product image URLs. Example: dunxugggm
VITE_CLOUDINARY_CLOUD_NAME=
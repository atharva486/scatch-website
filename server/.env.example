# ------------------------------------------------------------------------------
# Scatch API - environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------------------

# --- Required -----------------------------------------------------------------

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_KEY=replace_with_a_long_random_string

# MongoDB connection string.
#
# Development: you can LEAVE THIS EMPTY. With no MONGODB_URI the server starts an
# in-memory MongoDB automatically so you can run and demo the app with no setup.
# Data is lost on restart.
#
# Production: paste your MongoDB Atlas connection string here, e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/scatch?retryWrites=true&w=majority
MONGODB_URI=

# --- Production only (Render dashboard) ---------------------------------------

NODE_ENV=production
PORT=3000

# Comma-separated list of allowed frontend origins, e.g.
#   https://your-app.vercel.app,http://localhost:5173
# Leave empty to allow same-origin only.
CLIENT_URL=

# 'lax' | 'strict' | 'none'. Defaults to 'none' in production so the cookie
# survives the cross-site request from Vercel to Render.
COOKIE_SAMESITE=none

# --- Optional -----------------------------------------------------------------

# bcrypt cost factor (4-15, default 10)
ROUNDS=10

# JWT lifetime, e.g. 7d, 12h
JWT_EXPIRES_IN=7d

# --- Cloudinary (product images) ----------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
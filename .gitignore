# Dependencies
node_modules/

# Build output
client/dist/
dist/

# Real secrets. Never commit these - use .env.example as the template.
# (client/.gitignore and server/.gitignore already cover these, repeated here so
# a stray .env at any level is still ignored.)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.sw?